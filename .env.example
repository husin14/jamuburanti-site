# Salin file ini menjadi .env.local lalu isi nilainya. JANGAN commit .env.local.

# URL situs (dipakai untuk metadata, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: Project Settings > API Keys (dan Data API untuk URL)
# - URL project, contoh: https://abcdefghijklmnop.supabase.co
# - Publishable key (sb_publishable_...) atau "anon" key versi lama.
#   Aman dipakai di browser karena akses dibatasi Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Belum dipakai (Fase 4, panel admin). Kunci rahasia, JANGAN pernah dibagikan.
# SUPABASE_SECRET_KEY=

# Resend, opsional: notifikasi email saat ada pesan masuk dari form kontak
RESEND_API_KEY=
NOTIFIKASI_EMAIL_TUJUAN=

# Opsional, KHUSUS lokal: tampilkan testimoni contoh (dummy) untuk presentasi tugas.
# Jangan di-set di Vercel/produksi.
# MODE_PRESENTASI=1
